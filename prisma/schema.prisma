generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Customer {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  avatar    String?
  provider  String     @default("credentials")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]
  feedback  Feedback[]
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?       @db.Text
  imagePath   String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    Product[]
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  sku              String        @unique
  description      String        @db.Text
  shortDescription String
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  price            Decimal       @db.Decimal(14, 0)
  stock            Int           @default(0)
  imagePath        String?
  status           ProductStatus @default(ACTIVE)
  featured         Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  orderItems       OrderItem[]

  @@index([categoryId, status])
  @@index([name])
}

model Order {
  id                    String        @id @default(cuid())
  orderNumber           String        @unique
  customerId            String
  customer              Customer      @relation(fields: [customerId], references: [id])
  customerNameSnapshot  String
  customerEmailSnapshot String
  addressSnapshot       String        @db.Text
  phoneSnapshot         String
  subtotal              Decimal       @db.Decimal(14, 0)
  shippingTotal         Decimal       @db.Decimal(14, 0)
  total                 Decimal       @db.Decimal(14, 0)
  notes                 String?       @db.VarChar(300)
  status                OrderStatus   @default(PENDING)
  paymentStatus         PaymentStatus @default(UNPAID)
  stockDeducted         Boolean       @default(false)
  stockRestored         Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  items                 OrderItem[]

  @@index([customerId, createdAt])
  @@index([status, paymentStatus])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  productSku  String
  unitPrice   Decimal  @db.Decimal(14, 0)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(14, 0)

  @@index([orderId])
}

model Feedback {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name       String
  email      String
  message    String    @db.VarChar(1000)
  createdAt  DateTime  @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  path      String   @db.VarChar(200)
  visitorId String   @db.VarChar(64)
  day       String   @db.Char(10)
  createdAt DateTime @default(now())

  @@index([day])
  @@index([visitorId, day])
  @@index([path, createdAt])
}
